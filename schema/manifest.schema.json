{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krishddd/Wiki_textgraph/schema/manifest.schema.json",
  "title": "TextGraph manifest.json",
  "description": "Per-run accounting: pinned config, per-stage time/token/dollar budgets (G7).",
  "type": "object",
  "required": ["tool_version", "config_hash", "stages"],
  "additionalProperties": true,
  "properties": {
    "tool_version": { "type": "string" },
    "config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "llm_enabled": { "type": "boolean" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "wall_ms"],
        "properties": {
          "layer": {
            "type": "string",
            "pattern": "^L[0-9]$"
          },
          "wall_ms": { "type": "number", "minimum": 0 },
          "nodes_out": { "type": "integer", "minimum": 0 },
          "edges_out": { "type": "integer", "minimum": 0 },
          "tokens": { "type": "integer", "minimum": 0 },
          "dollars": { "type": "number", "minimum": 0 },
          "model": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  }
}
